# What `npm run start:dev` runs with: sign-in switched off, so every page and
# every API call goes straight through and everyone may edit. Drop AUTH_ENABLED
# to bring the gate back. For Microsoft sign-in, set AUTH_TENANT_ID,
# AUTH_CLIENT_ID, AUTH_CLIENT_SECRET and AUTH_SESSION_SECRET instead.
AUTH_ENABLED=false
NODE_ENV=development
AUTH_DEV_BYPASS=true
STORAGE_DIR=storage
# The Postgres from docker-compose.yml, which holds the versions of the map:
# `npm run db` starts it.
DATABASE_URL=postgres://{{slug}}:{{slug}}@localhost:5432/{{slug}}
# Who may edit and publish once sign-in is on, by the email they sign in with.
# Empty, everyone who signs in may.
OWNER_EMAILS=
# The model behind the Assistant. Both, or the Assistant writes prompts to copy
# into a chat of your own. Anything chat-completions shaped, or Anthropic's
# Messages API -- the URL says which, or ASSISTANT_API_STYLE does (openai |
# anthropic). Keep a real key out of this file: export it in the shell instead,
# which wins over anything here. A local Ollama wants any key at all:
#   ASSISTANT_API_URL=http://localhost:11434/v1/chat/completions
#   ASSISTANT_API_KEY=ollama
#   ASSISTANT_MODEL=llama3.1
