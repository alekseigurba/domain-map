# What `npm start` runs with. Sign-in is switched off for now: every page and
# every API call goes straight through, the sign-in screen bounces back to the
# map, and everyone may edit and publish. Nothing is removed -- drop
# AUTH_ENABLED to bring the gate back, and the screen then offers
# Bypass (dev). Anything already set in the shell wins over this file, so to try
# Microsoft sign-in locally, export AUTH_TENANT_ID, AUTH_CLIENT_ID and
# AUTH_CLIENT_SECRET first.
AUTH_ENABLED=false
NODE_ENV=development
AUTH_DEV_BYPASS=true
# The Postgres from docker-compose.yml: `docker compose up -d postgres`.
DATABASE_URL=postgres://domainmap:domainmap@localhost:5432/domainmap
# Who may edit and publish once sign-in is on, by the email they sign in with.
# The bypass is always an owner.
OWNER_EMAILS=
